# Copy this file to ".env" for local development and fill in your real key.
# NEVER commit your real .env file to GitHub.

# Required: API key for your LLM provider.
LLM_API_KEY=your_api_key_here

# Optional: model name. Defaults to "gpt-4o-mini" if not set.
LLM_MODEL=gpt-4o-mini

# Optional: only needed if you're using an OpenAI-compatible provider other
# than OpenAI itself (e.g. Groq, Together AI, OpenRouter). Leave blank/unset
# to use OpenAI directly.
# Example (Groq):        LLM_BASE_URL=https://api.groq.com/openai/v1
# Example (OpenRouter):  LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
